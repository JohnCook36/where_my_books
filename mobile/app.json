{
  "expo": {
    "name": "BookNook",
    "slug": "where-my-books",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "booknook",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите WhereMyBook использовать камеру для сканирования ISBN и фотографирования обложек.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите WhereMyBook выбрать фотографию для обложки книги.",
          "cameraPermission": "Разрешите WhereMyBook фотографировать обложки книг.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.johncook.wheremybooks"
    }
  }
}
