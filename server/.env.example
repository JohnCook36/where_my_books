DATABASE_URL="postgresql://booknook:booknook@localhost:5432/booknook?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
PORT=3000

# Optional project quota; never put this in EXPO_PUBLIC_* or commit a real key.
GOOGLE_BOOKS_API_KEY=""

# Browser origins allowed to call the API (comma-separated, exact scheme + host + port).
# Set explicitly in production; native mobile requests normally have no Origin header.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8081"

# If behind a reverse proxy, configure Express trust proxy ONLY for known proxies.
# Built-in auth limiter is per process; deploy a shared edge/distributed limiter too.
