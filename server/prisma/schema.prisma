generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CoverStyle {
  parchment
  forest
  burgundy
  midnight
}

enum CoverMode {
  automatic
  catalog
  custom
  placeholder
}

enum UserCoverSource {
  gallery
  camera
}

enum ReadingStatus {
  want_to_read
  reading
  finished
  dnf
}

enum ProgressDisplayMode {
  pages
  percentage
}

enum JournalEntryKind {
  note
  quote
}

enum ProgressChangeSource {
  manual
  session
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  passwordResets PasswordReset[]
  bookCopies   BookCopy[]
  settings     UserSettings?
  scanDrafts   ScanDraft[]
  coverAssets  CoverAsset[]
  storageRooms StorageRoom[]
  shelves Shelf[]
  shelfSections ShelfSection[]
  shelfRows ShelfRow[]
  shelfPlacements ShelfPlacement[]
  shelfLayout ShelfLayout?
  shelfOperations ShelfOperation[]
  journalEntries JournalEntry[]
  readingSessions ReadingSession[]
  progressEvents ReadingProgressEvent[]
  readingGoal ReadingGoal?
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Author {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  works     WorkAuthor[]
}

model BookWork {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  originalTitle String?
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  authors       WorkAuthor[]
  editions      Edition[]
}

model WorkAuthor {
  workId   String   @db.Uuid
  authorId String   @db.Uuid
  work     BookWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  author   Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([workId, authorId])
}

model Edition {
  id              String     @id @default(uuid()) @db.Uuid
  workId          String     @db.Uuid
  isbn            String?
  publisher       String?
  publicationYear Int?
  pageCount       Int
  coverUri        String?
  language        String?
  catalogSource   String?
  externalId      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  work            BookWork   @relation(fields: [workId], references: [id], onDelete: Cascade)
  copies          BookCopy[]

  @@index([workId])
  @@index([isbn])
}

model BookCopy {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  editionId    String       @db.Uuid
  status       ReadingStatus @default(want_to_read)
  clientRequestId String?      @db.Uuid
  requestHash     String?
  coverUri      String?
  coverStyle    CoverStyle @default(parchment)
  coverMode     CoverMode @default(automatic)
  coverAssetId  String? @db.Uuid
  coverAsset    CoverAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  currentPage  Int          @default(0)
  spineColor   String       @default("#2C4A3E")
  spineWidth   Float        @default(64)
  spineHeight  Float        @default(180)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition      Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([editionId])
  @@index([coverAssetId])
  placement ShelfPlacement?
  journalEntries JournalEntry[]
  readingSessions ReadingSession[]
  progressEvents ReadingProgressEvent[]

  @@unique([id, userId])
  @@unique([userId, clientRequestId])
}

model UserSettings {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  progressDisplayMode ProgressDisplayMode @default(pages)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScanDraft {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  isbn      String
  payload   Json?
  reviewed  Boolean  @default(false)
  revision  Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isbn])
}

model CoverAsset {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  source    UserCoverSource
  checksum  String
  mimeType  String
  width     Int
  height    Int
  byteSize  Int
  bytes     Bytes
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  copies    BookCopy[]

  @@unique([userId, checksum])
}


model ShelfLayout {
  userId String @id @db.Uuid
  revision Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model ShelfOperation {
  userId String @db.Uuid
  requestId String @db.Uuid
  requestHash String
  resultRevision Int
  undo Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, requestId])
}
model StorageRoom {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelves Shelf[]
  @@unique([id, userId])
  @@index([userId])
}
model Shelf {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roomId String @db.Uuid
  name String
  theme String @default("oak")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room StorageRoom @relation(fields: [roomId, userId], references: [id, userId], onDelete: Cascade)
  sections ShelfSection[]
  @@unique([id, userId])
  @@index([userId])
  @@index([roomId, userId])
}
model ShelfSection {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  shelfId String @db.Uuid
  name String
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelf Shelf @relation(fields: [shelfId, userId], references: [id, userId], onDelete: Cascade)
  rows ShelfRow[]
  @@unique([id, userId])
  @@index([userId])
  @@index([shelfId, userId])
}
model ShelfRow {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  sectionId String @db.Uuid
  name String
  capacity Int @default(80)
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  section ShelfSection @relation(fields: [sectionId, userId], references: [id, userId], onDelete: Cascade)
  placements ShelfPlacement[]
  @@unique([id, userId])
  @@index([userId])
  @@index([sectionId, userId])
}
model ShelfPlacement {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  copyId String @unique @db.Uuid
  rowId String @db.Uuid
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  copy BookCopy @relation(fields: [copyId, userId], references: [id, userId], onDelete: Cascade)
  row ShelfRow @relation(fields: [rowId, userId], references: [id, userId], onDelete: Cascade)
  @@unique([copyId, userId])
  @@unique([rowId, position])
  @@index([userId])
}

model JournalEntry {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  copyId    String @db.Uuid
  kind      JournalEntryKind
  body      String @db.VarChar(5000)
  page      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  copy BookCopy @relation(fields: [copyId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, copyId, createdAt])
}

model ReadingSession {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  copyId          String   @db.Uuid
  startPage       Int
  endPage         Int?
  durationSeconds Int?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  copy BookCopy @relation(fields: [copyId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, copyId, startedAt])
  @@index([userId, finishedAt])
}

model ReadingProgressEvent {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  copyId    String @db.Uuid
  fromPage  Int
  toPage    Int
  source    ProgressChangeSource
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  copy BookCopy @relation(fields: [copyId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, copyId, createdAt])
}

model ReadingGoal {
  userId String @id @db.Uuid
  finishedBooksTarget Int @default(12)
  weeklyMinutesTarget Int @default(180)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
